{
  "name": "bitapps/bit-connect",
  "description": "A community forum for WordPress where users raise feature requests, report issues, send feedback and vote on what gets built next.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "bitapps/wp-validator": "^1",
    "bitapps/wp-database": "2.0.5",
    "bitapps/wp-kit": "^2.4",
    "typisttech/imposter-plugin": "^0.6.2"
  },
  "autoload": {
    "psr-4": {
      "BitApps\\BitConnect\\": "./backend/app"
    }
  },
  "extra": {
    "imposter": {
      "namespace": "BitApps\\BitConnect\\Deps\\"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "typisttech/imposter-plugin": true,
      "phpstan/extension-installer": true
    }
  }
}
